#------------------------------------------------------------------------------
# exiftool-fujify.config — a custom XMP namespace for remembering what a file
# used to be, before Fujify rewrote its camera identity.
#
# Passed to every exiftool read and write as `-config <this file>`.
# See docs/PIPELINE-CONTRACT.md §3.2.
#
# Why this exists: writing the Fujifilm tags is destructive for DNG input
# processed in place — the camera that actually took the frame is overwritten
# and there is no way back. Stashing the original three strings here costs
# nothing (they go in the same write) and is what makes a future
# "Remove Fujify tags" action possible at all.
#
# Tags, all plain strings under XMP-fujify:
#   OriginalMake               Make before Fujify touched the file
#   OriginalModel              Model before Fujify touched the file
#   OriginalUniqueCameraModel  UniqueCameraModel before Fujify touched it
#   TargetModel                which target was written, e.g. X-T5
#   Version                    stash format version, currently 1
#
# The namespace URI is a Fujify-specific URL and is never resolved over the
# network; it only has to be globally unique, which is how XMP namespaces work.
#------------------------------------------------------------------------------

%Image::ExifTool::UserDefined::fujify = (
    GROUPS    => { 0 => 'XMP', 1 => 'XMP-fujify', 2 => 'Image' },
    NAMESPACE => { 'fujify' => 'https://josephsintum.dev/ns/fujify/1.0/' },
    WRITABLE  => 'string',

    OriginalMake              => { },
    OriginalModel             => { },
    OriginalUniqueCameraModel => { },
    TargetModel               => { },
    Version                   => { },
);

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        fujify => {
            SubDirectory => {
                TagTable => 'Image::ExifTool::UserDefined::fujify',
            },
        },
    },
);

1;  # this file must return a true value
